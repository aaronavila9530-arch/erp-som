{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "kiosk-erasmo": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ERP_SOM_KIOSK_USER": "erasmo.gomez",
        "EXPO_PUBLIC_ERP_SOM_KIOSK_NAME": "Erasmo Gomez"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "kiosk-patricia": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ERP_SOM_KIOSK_USER": "patricia.omier",
        "EXPO_PUBLIC_ERP_SOM_KIOSK_NAME": "Patricia Omier"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
